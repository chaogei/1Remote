<UserControl x:Class="_1RM.View.Settings.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             xmlns:settings="clr-namespace:_1RM.View.Settings"
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:view="clr-namespace:_1RM.View"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance settings:SettingsPageViewModel}"
             d:Background="White"
             d:DesignHeight="2450" d:DesignWidth="1000">

    <UserControl.Resources>
        <!--
            Modern Fluent Rail Button Style with icons, pill indicators, and smooth hover
        -->
        <Style x:Key="SettingsRailButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8 2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <!-- The rail is inside the paging area, so it is tinted from BackgroundColor: its labels and
                 glyphs follow BackgroundTextBrush. PrimaryTextBrush is the *panel* text colour, white on the
                 palettes with dark chrome over a light page, which made the whole rail disappear there. -->
            <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
            <Setter Property="Command" Value="{Binding CmdShowPage}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource DefaultCornerRadius}">
                            <Grid>
                                <!-- Left Active Indicator Pill -->
                                <Border x:Name="Indicator"
                                        Width="3" Height="18"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource AccentMidBrush}"
                                        Margin="0 0 0 0"
                                        Opacity="0" />

                                <StackPanel Orientation="Horizontal" Margin="14 0 12 0" VerticalAlignment="Center">
                                    <!-- the entry's icon, carried on Tag as a Geometry -->
                                    <Path x:Name="IconGlyph"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          UseLayoutRounding="True"
                                          VerticalAlignment="Center"
                                          Margin="0 0 10 0"
                                          Opacity="0.75"
                                          Fill="{TemplateBinding Foreground}" />
                                    <!-- Label -->
                                    <ContentPresenter x:Name="Label"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="ItemBorder" Value="{DynamicResource ContentLayerHoverBrush}" />
                                <Setter Property="Opacity" TargetName="IconGlyph" Value="1" />
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ConverterIsEqual}">
                                        <Binding Path="CurrentPage" />
                                        <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" TargetName="ItemBorder" Value="{DynamicResource ContentLayerSelectedBrush}" />
                                <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{DynamicResource ContentCardStrokeBrush}" />
                                <Setter Property="Opacity" TargetName="Indicator" Value="1" />
                                <Setter Property="Opacity" TargetName="IconGlyph" Value="1" />
                                <Setter Property="Fill" TargetName="IconGlyph" Value="{DynamicResource AccentMidBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- a faint overlay rather than a second tint, so the rail reads as raised without closing the glass -->
        <Grid Grid.Column="0" Background="{DynamicResource ContentLayerFillBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0 10 0 10">
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryGear}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsGeneral}"
                            Content="{DynamicResource system_options_general_title}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryLightning}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsLauncher}"
                            Content="{DynamicResource Launcher}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryDatabase}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsData}"
                            Content="{DynamicResource system_options_data_security_database}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryKey}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsCredentialVault}"
                            Content="{DynamicResource 'Credentials Vault'}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryNetwork}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsProxy}"
                            Content="{DynamicResource proxy_title}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryLightning}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsPortForward}"
                            Content="{DynamicResource port_forward_title}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryContrast}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsTheme}"
                            Content="{DynamicResource Theme}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryTerminal}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsRunners}"
                            Content="{DynamicResource Protocol}" />
                    <Button Style="{StaticResource SettingsRailButtonStyle}"
                            Tag="{StaticResource GeometryArchive}"
                            CommandParameter="{x:Static view:EnumMainWindowPage.SettingsBackup}"
                            Content="{DynamicResource backup_title}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Back Action Button -->
            <Border Grid.Row="1" Padding="8 8 8 12" Background="Transparent">
                <Button Height="36"
                        Style="{StaticResource GlassGhostButtonStyle}"
                        Command="{Binding CmdSaveAndGoBack}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeometryArrowLeft}"
                              Width="14" Height="14" Stretch="Uniform"
                              UseLayoutRounding="True"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Margin="0 0 8 0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Back}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <ContentControl Grid.Column="1" s:View.Model="{Binding SelectedViewModel}" />
    </Grid>
</UserControl>
