<UserControl x:Class="_1RM.View.Settings.Launcher.LauncherSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_1RM.View.Settings.Launcher"
             xmlns:service="clr-namespace:_1RM.Service"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance local:LauncherSettingViewModel}"
             d:DesignHeight="700" d:DesignWidth="840">
    <UserControl.Resources>
        <local:Key2KeyStringConverter x:Key="Key2KeyStringConverter"></local:Key2KeyStringConverter>
        <local:ConverterHotkeyModifierKeys x:Key="ConverterHotkeyModifierKeys"></local:ConverterHotkeyModifierKeys>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20 16 20 24">

                <!-- Page Header -->
                <TextBlock Text="{DynamicResource Launcher}" Style="{StaticResource BlockTitleColumn}" Margin="0 0 0 16" />

                <!-- Card 1: General & Hotkey -->
                <Border Background="{DynamicResource ContentLayerFillBrush}"
                        BorderBrush="{DynamicResource ContentCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="22 18"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <!-- Section Title -->
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                            <Path Data="{StaticResource GeometryLightning}"
                                  Width="15" Height="15" Stretch="Uniform"
                                  UseLayoutRounding="True"
                                  Fill="{DynamicResource AccentMidBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 8 0" />
                            <TextBlock Text="{DynamicResource Launcher}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource GlobalFontSizeTitle}"
                                       Foreground="{DynamicResource BackgroundTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Enable CheckBox -->
                        <Grid Style="{StaticResource GridOneRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LauncherCol1"></ColumnDefinition>
                                <ColumnDefinition MinWidth="260" SharedSizeGroup="LauncherCol2"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource Launcher}" Width="160"></TextBlock>
                            <CheckBox Grid.Column="1" IsChecked="{Binding LauncherEnabled, Mode=TwoWay}" VerticalAlignment="Center" Content="{DynamicResource system_options_quick_launcher_enable}"></CheckBox>
                        </Grid>

                        <StackPanel IsEnabled="{Binding LauncherEnabled, Mode=OneWay}" 
                                    Visibility="{Binding LauncherEnabled, Converter={StaticResource ConverterBool2Visible}}">
                            <!-- Hotkey Selector -->
                            <Grid Style="{StaticResource GridOneRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LauncherCol1"></ColumnDefinition>
                                    <ColumnDefinition MinWidth="260" SharedSizeGroup="LauncherCol2"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource system_options_quick_launcher_hotkey}" Width="160"></TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="110" 
                                              ItemsSource="{Binding HotkeyModifierKeys}"
                                              SelectedValuePath="Key"
                                              DisplayMemberPath="Value" 
                                              SelectedIndex="{Binding LauncherHotKeyModifiers, Converter={StaticResource ConverterHotkeyModifierKeys}}" />
                                    <TextBlock Text="+" VerticalAlignment="Center" Margin="12 0" Foreground="{DynamicResource BackgroundTextBrush}"></TextBlock>
                                    <TextBox Width="110"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="False"
                                             IsUndoEnabled="False"
                                             PreviewKeyDown="TextBoxKey_OnPreviewKeyDown"
                                             Text="{Binding LauncherHotKeyKey, Mode=OneWay, Converter={StaticResource Key2KeyStringConverter}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Show credentials info -->
                            <Grid Style="{StaticResource GridOneRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LauncherCol1"></ColumnDefinition>
                                    <ColumnDefinition MinWidth="260" SharedSizeGroup="LauncherCol2"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource 'Credentials Vault'}" Width="160"></TextBlock>
                                <CheckBox Grid.Column="1" IsChecked="{Binding ShowCredentials, Mode=TwoWay}" VerticalAlignment="Center" Content="{DynamicResource 'Show credentials info'}"></CheckBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Match Providers (Search Engine) -->
                <Border Background="{DynamicResource ContentLayerFillBrush}"
                        BorderBrush="{DynamicResource ContentCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="22 18"
                        Margin="0 0 0 16"
                        IsEnabled="{Binding LauncherEnabled, Mode=OneWay}">
                    <StackPanel>
                        <!-- Section Title -->
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                            <Path Data="{StaticResource GeometryMagnifier}"
                                  Width="15" Height="15" Stretch="Uniform"
                                  UseLayoutRounding="True"
                                  Fill="{DynamicResource AccentMidBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 8 0" />
                            <TextBlock Text="{DynamicResource system_options_quick_match_providers}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource GlobalFontSizeTitle}"
                                       Foreground="{DynamicResource BackgroundTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Matchers List -->
                        <Grid Margin="12 4 0 0">
                            <Grid.Resources>
                                <DataTemplate x:Key="DataTemplateForMatcher" DataType="service:MatchProviderInfo">
                                    <Border Margin="0 0 0 10" Padding="12 8"
                                            Background="{DynamicResource ContentLayerFillBrush}"
                                            BorderBrush="{DynamicResource ContentCardStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource DefaultCornerRadius}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <CheckBox Grid.Row="0" Cursor="Hand"
                                                      IsChecked="{Binding Enabled}"
                                                      IsEnabled="{Binding IsEditable}"
                                                      Content="{Binding Title1}"
                                                      FontWeight="SemiBold"
                                                      ToolTip="{Binding Title1}"></CheckBox>
                                            <TextBlock Grid.Row="1" Margin="22 4 0 0"
                                                       Text="{Binding Title2}"
                                                       ToolTip="{Binding Title2}"
                                                       FontSize="{DynamicResource GlobalFontSizeSmall}"
                                                       Opacity="0.7"></TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </Grid.Resources>
                            <ItemsControl Background="Transparent" BorderThickness="0"
                                          ItemsSource="{Binding AvailableMatcherProviders}" 
                                          ItemTemplate="{StaticResource DataTemplateForMatcher}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Quick Connect -->
                <Border Background="{DynamicResource ContentLayerFillBrush}"
                        BorderBrush="{DynamicResource ContentCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="22 18">
                    <StackPanel>
                        <!-- Section Title -->
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                            <Path Data="{StaticResource GeometryPlay}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  UseLayoutRounding="True"
                                  Fill="{DynamicResource AccentMidBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 8 0" />
                            <TextBlock Text="{DynamicResource 'Quick Connect'}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource GlobalFontSizeTitle}"
                                       Foreground="{DynamicResource BackgroundTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Style="{StaticResource GridOneRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LauncherCol1"></ColumnDefinition>
                                <ColumnDefinition MinWidth="260" SharedSizeGroup="LauncherCol2"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource 'Quick Connect'}" Width="160"></TextBlock>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AllowSaveInfoInQuickConnect, Mode=TwoWay}" 
                                      VerticalAlignment="Center" 
                                      Content="{DynamicResource 'Allow Quick Connect to save entered address information'}"></CheckBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
