<UserControl x:Class="_1RM.View.Utils.MessageBoxPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_1RM.View.Utils"
      xmlns:service="clr-namespace:_1RM.Service"
      xmlns:xaml="https://github.com/canton7/Stylet"
      xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance local:MessageBoxPageViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      FlowDirection="{Binding FlowDirection}">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
            <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="TextWrapping" Value="Wrap"></Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxAccentStyle}">
            <Setter Property="Margin" Value="0 5 0 15"></Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid>
            <!-- Card Container -->
            <Border Margin="12"
                    MinWidth="280" MaxWidth="520"
                    CornerRadius="{DynamicResource CardCornerRadius}" 
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource GlassContentBrush}"
                    BorderBrush="{DynamicResource ContentCardStrokeBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Header -->
                    <Border Background="{DynamicResource ContentLayerFillBrush}"
                            BorderBrush="{DynamicResource ContentCardStrokeBrush}"
                            BorderThickness="0 0 0 1"
                            CornerRadius="9 9 0 0">
                        <Grid Margin="12 0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="18" Height="18" Margin="0 0 8 0" VerticalAlignment="Center">
                                    <Image Source="/Resources/Image/Logo/logo32.png"></Image>
                                </Grid>
                                <TextBlock Text="{Binding DisplayName}" 
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource GlobalFontSizeBody}"
                                           Foreground="{DynamicResource BackgroundTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content Body -->
                    <Grid Grid.Row="1" Margin="20 18 20 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="{Binding ImageIcon, Converter={x:Static xaml:IconToBitmapSourceConverter.Instance}}"
                               Visibility="{Binding ImageIcon, Converter={x:Static xaml:BoolToVisibilityConverter.Instance}}"
                               Width="32" Height="32"
                               Margin="0 2 16 0"
                               VerticalAlignment="Top" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource GlobalFontSizeBody}"
                                   LineHeight="20"
                                   TextAlignment="{Binding TextAlignment}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Action Buttons -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource ContentLayerFillBrush}"
                            BorderBrush="{DynamicResource ContentCardStrokeBrush}"
                            BorderThickness="0 1 0 0"
                            Padding="16 10"
                            CornerRadius="0 0 9 9">
                        <ItemsControl ItemsSource="{Binding ButtonList}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" 
                                            MinWidth="80" 
                                            Height="30" 
                                            Margin="8 0 0 0"
                                            Command="{xaml:Action ButtonClicked}" 
                                            CommandParameter="{Binding Value}">
                                        <Button.Style>
                                            <!-- Every button starts as the ghost button and only the affirmative one is
                                                 repainted with the accent. The affirmative button used to be the base style
                                                 and No/Cancel swapped their Template for GlassGhostButtonStyle's — but that
                                                 resource is a Style, not a Control, so `{Binding Template, Source=...}`
                                                 resolved to null and left those buttons with no visual tree at all: a delete
                                                 confirmation rendered with 是 as its only clickable action. Only the fill,
                                                 the label and the border change here, so both buttons keep the ghost
                                                 template and stay visible whatever the palette. -->
                                            <Style TargetType="Button" BasedOn="{StaticResource GlassGhostButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="{x:Static MessageBoxResult.Yes}">
                                                        <Setter Property="Background" Value="{DynamicResource AccentGlassBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Value}" Value="{x:Static MessageBoxResult.OK}">
                                                        <Setter Property="Background" Value="{DynamicResource AccentGlassBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                                                    </DataTrigger>
                                                    <!-- A style trigger outranks the template's own IsMouseOver/IsPressed
                                                         triggers, so the accent variants need their own hover states. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Value}" Value="{x:Static MessageBoxResult.Yes}" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Value}" Value="{x:Static MessageBoxResult.OK}" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Value}" Value="{x:Static MessageBoxResult.Yes}" />
                                                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource AccentMidBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Value}" Value="{x:Static MessageBoxResult.OK}" />
                                                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource AccentMidBrush}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
