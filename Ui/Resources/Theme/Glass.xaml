<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
                    xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                    xmlns:theme="clr-namespace:_1RM.Utils.Theme">

    <!-- Merged so the copies below can reach the keys they build on — ComboBoxTemplate needs
         ComboBoxToggleButton and ControlBase, the caption button styles need ButtonBarPrimaryStyle:
         a StaticResource inside a dictionary is resolved against that dictionary, not the application. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Shawn.Utils.WpfResources;component/Theme/Styles/ComboBoxStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Shawn.Utils.WpfResources;component/Theme/Styles/ButtonStyle.xaml" />
        <!-- Last, so DefaultInputPadding resolves to TextBoxStyle's 8,4 the way DefaultTheme.xaml orders it,
             and not to the 5,4 ButtonStyle.xaml declares for itself. -->
        <ResourceDictionary Source="pack://application:,,,/Shawn.Utils.WpfResources;component/Theme/Styles/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Shawn.Utils.WpfResources;component/Theme/Styles/TextBoxStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Everything here overrides a key that Shawn.Utils.WpfResources already defines. It lives in this
        project, and not in that one, because Shawn.Utils is a git submodule pointing at an upstream
        repository we cannot push to: anything committed there would be missing from a fresh clone and from
        CI, which checks the submodule out at its pinned commit.

        Merge order matters — App.xaml merges this after DefaultTheme.xaml so these win. ThemeService is
        merged later still and recomputes the Layer*/Glass*/AcrylicTintColor keys from the active theme
        colours; the values below are the design-time and pre-ApplyTheme fallback, keep the two in step.
    -->

    <!-- ===== corner radii =====
         Three steps rather than one: controls stay tight so a 30px row does not read as a pill, while cards
         and windows get the softer radius the frosted panels are built around. -->
    <system:Double x:Key="DefaultCornerRadiusValue">6</system:Double>
    <CornerRadius x:Key="DefaultCornerRadius" TopLeft="{StaticResource DefaultCornerRadiusValue}" TopRight="{StaticResource DefaultCornerRadiusValue}" BottomLeft="{StaticResource DefaultCornerRadiusValue}" BottomRight="{StaticResource DefaultCornerRadiusValue}" />

    <system:Double x:Key="CardCornerRadiusValue">10</system:Double>
    <CornerRadius x:Key="CardCornerRadius" TopLeft="{StaticResource CardCornerRadiusValue}" TopRight="{StaticResource CardCornerRadiusValue}" BottomLeft="{StaticResource CardCornerRadiusValue}" BottomRight="{StaticResource CardCornerRadiusValue}" />

    <system:Double x:Key="WindowCornerRadiusValue">10</system:Double>
    <CornerRadius x:Key="WindowCornerRadius" TopLeft="{StaticResource WindowCornerRadiusValue}" TopRight="{StaticResource WindowCornerRadiusValue}" BottomLeft="{StaticResource WindowCornerRadiusValue}" BottomRight="{StaticResource WindowCornerRadiusValue}" />

    <!-- Design-time fallback for the display size ThemeService computes from the user's font size. -->
    <system:Double x:Key="GlobalFontSizeLarge">22</system:Double>

    <!-- ===== translucent elevation layers =====
         Derived from the foreground colour at low alpha rather than hard-coded, so one set of keys reads
         correctly on both light and dark themes: on dark it lightens the surface, on light it darkens it. -->
    <SolidColorBrush x:Key="LayerFillBrush" Color="#CCCCCC" Opacity="0.06" />
    <SolidColorBrush x:Key="LayerHoverBrush" Color="#CCCCCC" Opacity="0.10" />
    <SolidColorBrush x:Key="LayerSelectedBrush" Color="#CCCCCC" Opacity="0.17" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#CCCCCC" Opacity="0.14" />

    <!-- The tab strip of the session window, which can never take DWM frost (see
         ThemeService.ApplyGlassLayers and AcrylicBehavior's denylist). A flat Layer* tint over PrimaryMid
         reads as a slab of window fill; the falling gradient gives the strip the bright top edge a sheet of
         glass has. Design-time and pre-ApplyTheme fallback for the theme-derived brush. -->
    <LinearGradientBrush x:Key="TitleBarGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3ACCCCCC" Offset="0" />
        <GradientStop Color="#22CCCCCC" Offset="0.07" />
        <GradientStop Color="#15CCCCCC" Offset="0.55" />
        <GradientStop Color="#0ECCCCCC" Offset="1" />
    </LinearGradientBrush>

    <!-- the same four, for content sitting on BackgroundBrush instead of PrimaryMidBrush -->
    <SolidColorBrush x:Key="ContentLayerFillBrush" Color="#FFFFFF" Opacity="0.05" />
    <SolidColorBrush x:Key="ContentLayerHoverBrush" Color="#FFFFFF" Opacity="0.09" />
    <SolidColorBrush x:Key="ContentLayerSelectedBrush" Color="#FFFFFF" Opacity="0.14" />
    <SolidColorBrush x:Key="ContentCardStrokeBrush" Color="#FFFFFF" Opacity="0.12" />

    <!-- ===== backdrop set =====
         WindowBackdropBrush stays opaque here and is replaced with a transparent brush per window, by
         AcrylicBehavior, only once the OS has accepted the composition attribute — so a machine that cannot
         do acrylic still gets a solid, readable window. -->
    <Color x:Key="AcrylicTintColor">#40323233</Color>
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#323233" />
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#B4323233" />
    <SolidColorBrush x:Key="GlassContentBrush" Color="#B41E1E1E" />

    <!-- The accent, kept as the accent, but let down enough that a primary action stops reading as a solid
         brick punched through the frost. Deliberately far more opaque than the panel brushes: this one has
         to keep AccentTextBrush legible on top of whatever the desktop happens to be showing. -->
    <SolidColorBrush x:Key="AccentGlassBrush" Color="#D8007ACC" />

    <!--
        Always opaque, for surfaces that float in their own window and so have nothing behind them to
        composite against — a tooltip or a completion popup would otherwise turn see-through onto the
        desktop. Everything that sits inside the main window should use BackgroundBrush instead, which
        ThemeService makes translucent while the backdrop is on.
    -->
    <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SolidPanelBrush" Color="#323233" />

    <!-- ===== window chrome =====
         Same template as WindowChromeBaseStyles.xaml, with the fill switched to WindowBackdropBrush so the
         acrylic can show through, and the hard border replaced by the hairline card stroke.

         The corners are deliberately left square: rounding this Border would not clip the opaque content
         inside it, and Windows 11 already rounds top level windows itself. -->
    <Style x:Key="WindowChromeBaseBaseStyle" TargetType="styles:WindowChromeBase">
        <!-- Windows that explicitly use this style (MainWindow, ErrorReport) ask for the backdrop here.
             Derived WindowChromeBase dialogs do not receive this setter: WPF implicit styles match the
             exact runtime type, so AcrylicBehavior opts those in from a Window.Loaded class handler.
             TabWindowView / FullScreenWindowView / ErrorReportWindow stay on the type-name denylist
             because they host a Win32 HWND or draw a transparent halo. ComboBox drop-downs are Popups. -->
        <Setter Property="theme:AcrylicBehavior.IsEnabled" Value="True" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0"
                              GlassFrameThickness="1"
                              ResizeBorderThickness="3"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="styles:WindowChromeBase">
                    <Border x:Name="WindowBorder" Padding="0" Background="{DynamicResource WindowBackdropBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                            </Style>
                        </Border.Style>
                        <Grid x:Name="WindowContentGrid" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowContentGrid" Property="Margin" Value="8 6 8 8" />
                            <Setter TargetName="WindowBorder" Property="BorderThickness" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowStyle}" Value="None">
                <Setter Property="AllowsTransparency" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="styles:WindowChromeBase" BasedOn="{StaticResource WindowChromeBaseBaseStyle}" />


    <!-- ===== combo box =====
         A copy of ComboBoxStyle.xaml's template with exactly two fills changed. The closed control and its
         drop-down both painted themselves with {TemplateBinding Background}, which is why making that one
         brush translucent — the obvious way to glassify every control at once — turned the drop-down list
         see-through onto the desktop and left it unreadable. Splitting them here lets the closed control sit
         on the frosted panel as a faint tint while the popup, which is its own top level window with nothing
         behind it, stays solid.

         Everything else is verbatim from the submodule; ComboBoxBaseStyle points at this key with
         DynamicResource, so redefining it is enough and the submodule stays untouched. -->
    <ControlTemplate x:Key="ComboBoxTemplate" TargetType="ComboBox">
        <Grid>
            <Border Name="BorderForBackground"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource ContentLayerFillBrush}"
                    BorderThickness="0"
                    BorderBrush="Transparent"
                    CornerRadius="{Binding Path=(attachProperty:VisionElement.BorderCornerRadius),RelativeSource={RelativeSource TemplatedParent}}"/>

            <Border Name="BorderForText"
                    SnapsToDevicePixels="True"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{Binding Path=(attachProperty:VisionElement.BorderCornerRadius),RelativeSource={RelativeSource TemplatedParent}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.ColumnSpan="2" Name="ToggleButton"
                                  FontFamily="{TemplateBinding FontFamily}"
                                  FontSize="{TemplateBinding FontSize}"
                                  IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Background="Transparent"
                                  Foreground="{TemplateBinding Foreground}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Style="{StaticResource ComboBoxToggleButton}"/>

                    <ContentPresenter Grid.Column="0" Margin="8 4 0 4"
                                      x:Name="ContentPresenter"
                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                      TextBlock.FontSize="{TemplateBinding FontSize}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      IsHitTestVisible="false" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                    <TextBox Margin="6 4 0 4" MinWidth="100"
                             Grid.Column="0" Name="PART_EditableTextBox"
                             Foreground="{TemplateBinding Foreground}"
                             CaretBrush="{TemplateBinding Foreground}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="{TemplateBinding FontSize}"
                             Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="True" >
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource ControlBase}">
                                <Setter Property="OverridesDefaultStyle" Value="true" />
                                <Setter Property="AllowDrop" Value="true" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
                                <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer Padding="{TemplateBinding Padding}" x:Name="PART_ContentHost" Background="Transparent" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Column="0"
                               x:Name="PART_Tag"
                               Cursor="IBeam"
                               Margin="6 4 0 4"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               IsHitTestVisible="False"
                               Text="{TemplateBinding Tag}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Name="Border"
                    SnapsToDevicePixels="True"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="{Binding Path=(attachProperty:VisionElement.BorderCornerRadius),RelativeSource={RelativeSource TemplatedParent}}">
            </Border>

            <!-- Popup showing items -->
            <Popup Name="Popup" Placement="Bottom"
                   Focusable="False" AllowsTransparency="True"
                   IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}"
                   PlacementTarget="{Binding ElementName=BorderForBackground}"
                   PopupAnimation="Slide">
                <Border SnapsToDevicePixels="True"
                        Margin="8,0,8,8" Effect="{DynamicResource EffectShadow2}"
                        Background="{DynamicResource SolidSurfaceBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="{Binding Path=(attachProperty:VisionElement.BorderCornerRadius),RelativeSource={RelativeSource TemplatedParent}}">
                    <Grid Name="DropDown" SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}">
                        <Border SnapsToDevicePixels="True"
                                Name="BorderForItemsPresenter"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="{Binding Path=(attachProperty:VisionElement.BorderCornerRadius),RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer SnapsToDevicePixels="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                TextElement.FontSize="{TemplateBinding FontSize}"
                                                TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                TextBlock.FontSize="{TemplateBinding FontSize}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ItemsControl.IsGrouping" Value="True">
                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            </Trigger>
            <Trigger Property="ComboBox.IsEditable" Value="True">
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                <Setter Property="UIElement.Visibility" TargetName="PART_EditableTextBox" Value="Visible"/>
                <Setter Property="UIElement.Visibility" TargetName="ContentPresenter" Value="Hidden"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDropDownOpen" Value="False"></Condition>
                    <Condition Property="IsMouseOver" Value="True"></Condition>
                </MultiTrigger.Conditions>
                <Setter Property="Background" TargetName="BorderForBackground" Value="{DynamicResource ContentLayerHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" TargetName="ToggleButton" Value="{Binding Path=(attachProperty:VisionElement.BackgroundAccent),RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{Binding Path=(attachProperty:VisionElement.BackgroundAccent),RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="BorderBrush" TargetName="BorderForItemsPresenter" Value="{Binding Path=(attachProperty:VisionElement.BackgroundAccent),RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="Foreground" TargetName="ToggleButton" Value="{Binding Path=(attachProperty:VisionElement.BackgroundAccent),RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{Binding Path=(attachProperty:VisionElement.BackgroundAccent),RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="BorderBrush" TargetName="BorderForItemsPresenter" Value="{Binding Path=(attachProperty:VisionElement.BackgroundAccent),RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="IsEnabled" TargetName="ToggleButton" Value="False"/>
                <Setter Property="Visibility" TargetName="ToggleButton" Value="Collapsed"/>
                <Setter Property="Visibility" TargetName="Popup" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" TargetName="PART_Tag" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===== data grid =====
         DataGrid.xaml gives the grid, every row and every cell an opaque BackgroundBrush fill, so setting
         Background="Transparent" on the DataGrid itself — which both the data-source and credential pages
         already did — only cleared the area below the last row. Each populated row still painted a solid
         white slab over the backdrop, which is what made the single Local/Sqlite row stand out as the one
         opaque thing on an otherwise frosted settings page.

         All three fills go transparent here; the row keeps a hover overlay so pointing at a row still
         reads. Based on ControlBase rather than the Base keys these replace: a StaticResource inside a
         dictionary resolves against that dictionary first, so basing an override on the key it replaces is
         a cycle. DataGrid.xaml is not merged above, so the setters it contributes are restated. -->
    <Style x:Key="GlassDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ControlBase}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnWidth" Value="*" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="DataGridBaseStyle" TargetType="DataGrid" BasedOn="{StaticResource GlassDataGridStyle}" />
    <Style TargetType="DataGrid" BasedOn="{StaticResource GlassDataGridStyle}" />

    <Style x:Key="GlassDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource ControlBase}">
        <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeSubtitle}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridCellBaseStyle" TargetType="DataGridCell" BasedOn="{StaticResource GlassDataGridCellStyle}" />
    <Style TargetType="DataGridCell" BasedOn="{StaticResource GlassDataGridCellStyle}" />

    <!-- The row carries the hover tint rather than the cell, so it spans the whole row instead of lighting
         up one column at a time. -->
    <Style x:Key="GlassDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ControlBase}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ContentLayerFillBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridRowBaseStyle" TargetType="DataGridRow" BasedOn="{StaticResource GlassDataGridRowStyle}" />
    <Style TargetType="DataGridRow" BasedOn="{StaticResource GlassDataGridRowStyle}" />

    <!-- DataGridColumnHeader is deliberately left to the submodule. Its opaque fill only shows through the
         template DataGrid.xaml supplies, and every grid in this app replaces that template with one that
         paints no background of its own. Overriding the style here would drop the template with it and
         hand the headers back to the WPF Aero default. -->

    <!-- ===== window caption buttons =====
         The minimise / maximise / close cluster is drawn by us, not by the OS (UseAeroCaptionButtons is
         False and CaptionHeight is 0), and it used to take ButtonBarPrimaryStyle as-is. That style paints
         PrimaryMidBrush at rest and PrimaryLightBrush on hover, both fully opaque. Before the frosted
         chrome that was invisible, because the title bar was PrimaryMid too; now the strip is
         GlassPanelBrush over the DWM blur, so three opaque rectangles punched a solid slab through the
         glass in the top right corner — on every palette, since PrimaryMid is what every theme defines.

         So: transparent at rest, which lets the one tint the title bar already applies show through
         instead of stacking a second translucent layer on top of it, and Layer* overlays for the
         interactive states. Those are the foreground colour at a low alpha (see ThemeService.
         ApplyGlassLayers), which darkens a light theme and lightens a dark one, so a single pair of keys
         stays visible either way.

         BasedOn rather than a fresh template on purpose: ButtonBarPrimaryStyle's template already reads
         its fills from Background and the VisionElement attached properties, so the call sites that
         override those per button — the close buttons and their red hover — keep working untouched. -->
    <Style x:Key="WindowCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBarPrimaryStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource LayerHoverBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="{DynamicResource LayerSelectedBrush}" />
        <!-- the inherited 0.8 would fade the pressed fill back down to roughly the hover one, and dim the
             glyph with it; the deeper Layer brush is the whole press affordance here -->
        <Setter Property="attachProperty:VisionElement.OpacityOnMouseDown" Value="1" />
    </Style>

    <!-- Windows' own close-button red, kept because it is the one caption affordance users read by colour.
         Idle stays transparent like its neighbours; only hover and press light up. -->
    <Style x:Key="WindowCaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="White" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="#E81123" />
        <Setter Property="attachProperty:VisionElement.ForegroundOnMouseDown" Value="White" />
        <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="#C4101E" />
    </Style>

    <!-- ===== tab strips and column headers =====
         The home page's "All" / "Tags" tabs, the pinned tag chips and the protocol / name / target sort
         headers were all built on ButtonBarPrimaryStyle. That style is BasedOn the submodule's own
         ButtonPrimaryStyle, resolved inside that dictionary, so the ButtonPrimaryStyle override further
         down this file cannot reach it — which is why those controls kept their opaque PrimaryMid fill
         while the rest of the page went to glass, and why the selected tab read as a solid accent brick.

         Rather than redefine ButtonBarPrimaryStyle globally (its other call sites sit on panel-coloured
         surfaces and need PrimaryTextBrush, not BackgroundTextBrush), these two styles are the versions
         for controls that sit on the content tint, and the call sites point at them by name.

         Both are transparent at rest so the one tint their bar already applies shows through instead of a
         second layer stacking on top of it, and both take their interactive states from the ContentLayer*
         overlays — the foreground colour at a low alpha, which darkens a light theme and lightens a dark
         one, so one pair of keys stays visible on either. -->
    <Style x:Key="GlassTabButtonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True" />
                        <!-- Hover is its own overlay rather than a second value for Background, so a call
                             site is free to bind Background to the selected state without the two fighting
                             over the same property: on an unselected tab this is the only tint there is,
                             on the selected one it lifts the accent a step. -->
                        <Border x:Name="HoverOverlay" Background="Transparent" SnapsToDevicePixels="True" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Background" Value="{DynamicResource ContentLayerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keeps ButtonBaseStyle's template, so the sort arrows and the label keep laying out exactly as they
         did; only the fills and the foregrounds move onto the content palette. -->
    <Style x:Key="GlassColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BorderCornerRadius" Value="{DynamicResource DefaultCornerRadius}" />
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource ContentLayerHoverBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundOnMouseDown" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="{DynamicResource ContentLayerFillBrush}" />
        <!-- the inherited 0.8 dims the label along with the fill, and the deeper overlay is already the
             press affordance -->
        <Setter Property="attachProperty:VisionElement.OpacityOnMouseDown" Value="1" />
    </Style>

    <!-- ===== Modern Acrylic / Glass Button Styles =====
         ContentLayer* rather than Layer*, to match the BackgroundTextBrush foreground below: every call site
         is a settings or dialog page, which is tinted from BackgroundColor. On the palettes where the panel
         text is white and the content text is black — PRemoteM, SecretKey — the Layer* overlays washed these
         buttons in white over a light page, leaving no visible fill or border at all. -->
    <Style x:Key="GlassGhostButtonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14 4" />
        <Setter Property="Background" Value="{DynamicResource ContentLayerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource DefaultCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ContentLayerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ContentLayerSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassGhostButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource DefaultCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#25E81123" />
                            <Setter Property="BorderBrush" Value="#40E81123" />
                            <Setter Property="Foreground" Value="#FFFF6B6B" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#40E81123" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassAccentButtonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="18 4" />
        <Setter Property="Background" Value="{DynamicResource AccentGlassBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource DefaultCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== input controls =====
         Same problem the ComboBox had, and the same shape of fix. Every control in Shawn.Utils inherits
         ControlBase, which hands it BackgroundBrush; that brush has to stay opaque (ThemeService says why),
         so a TextBox, a PasswordBox and a CheckBox well each painted a solid rectangle on top of the frost —
         a white slab in a light theme, most obviously the note editor and the WebDAV fields.
         Only the fill changes here: a low-alpha overlay derived from the foreground colour, so the well
         still reads as a well on both light and dark palettes, and the caret, the text and the red
         validation border are all untouched.

         Each override is BasedOn a key that is *not* itself overridden below — TextBoxPrimaryStyle,
         PasswordBoxPrimaryStyle, CheckBoxPrimaryStyle, ButtonBaseStyle. A StaticResource inside a dictionary
         resolves against that same dictionary first, so basing an override on the key it replaces is a
         cycle, not a fallback to the merged original. The Primary keys are the unused links in each chain,
         which is what makes them usable as anchors.

         PasswordBoxBaseStyleWithoutEye is left alone for the same reason and frosted at its one call site,
         Controls/PasswordInput.xaml — it is a sibling template, not part of this chain. -->
    <Style x:Key="GlassTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxPrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource ContentLayerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentCardStrokeBrush}" />
    </Style>

    <Style x:Key="TextBoxBaseStyle" TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}" />

    <Style x:Key="TextBoxAccentStyle" TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}">
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource AccentDarkBrush}" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}">
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource AccentDarkBrush}" />
    </Style>


    <Style x:Key="GlassPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource PasswordBoxPrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource ContentLayerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentCardStrokeBrush}" />
    </Style>

    <Style x:Key="PasswordBoxBaseStyle" TargetType="PasswordBox" BasedOn="{StaticResource GlassPasswordBoxStyle}" />

    <Style x:Key="PasswordBoxAccentStyle" TargetType="PasswordBox" BasedOn="{StaticResource GlassPasswordBoxStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="true">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource GlassPasswordBoxStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="true">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Only the empty well is frosted. The checked state still fills with the accent from
         VisionElement.BackgroundAccent, which is the whole point of the tick being visible at a glance. -->
    <Style x:Key="GlassCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CheckBoxPrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource ContentLayerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentCardStrokeBrush}" />
    </Style>

    <Style x:Key="CheckBoxBaseStyle" TargetType="CheckBox" BasedOn="{StaticResource GlassCheckBoxStyle}" />

    <Style x:Key="CheckBoxAccentStyle" TargetType="CheckBox" BasedOn="{StaticResource GlassCheckBoxStyle}">
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource AccentMidBrush}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource GlassCheckBoxStyle}">
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource AccentMidBrush}" />
    </Style>


    <!-- ===== form buttons =====
         ButtonPrimaryStyle fills with PrimaryMidBrush, which is the same brush the title strips and the
         frosted panels are tinted with — so every Select / Test / Save / Cancel in the editor and the
         settings forms was an opaque rectangle of panel colour sitting on the glass. The template is kept
         as-is on purpose: call sites override the VisionElement fills and foregrounds per button, and those
         overrides all keep working when only the default fills move to the Layer* overlays.

         ButtonBarPrimaryStyle is untouched and stays solid. It is BasedOn the submodule's own
         ButtonPrimaryStyle, resolved inside that dictionary, so this override cannot reach it — which is
         what we want: the list rows and the caption cluster sit on surfaces where solid is correct, and the
         caption buttons already have WindowCaptionButtonStyle above. -->
    <Style x:Key="ButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ContentLayerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentCardStrokeBrush}" />
        <Setter Property="attachProperty:VisionElement.BorderOpacity" Value="1" />
        <Setter Property="attachProperty:VisionElement.BorderOpacityAccent" Value="1" />
        <Setter Property="attachProperty:VisionElement.BorderOpacityOnMouseDown" Value="1" />
        <Setter Property="attachProperty:VisionElement.BorderBrushOnMouseOver" Value="{DynamicResource AccentMidBrush}" />
        <Setter Property="attachProperty:VisionElement.BorderBrushOnMouseDown" Value="{DynamicResource AccentMidBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource ContentLayerHoverBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="{DynamicResource ContentLayerSelectedBrush}" />
        <!-- the inherited 0.8 dims the label along with the fill, and the deeper Layer brush is already the
             press affordance -->
        <Setter Property="attachProperty:VisionElement.OpacityOnMouseDown" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundOnMouseDown" Value="{DynamicResource BackgroundTextBrush}" />
    </Style>

    <!-- The same button for the handful of cards that are tinted from PrimaryMid rather than from
         Background: the guidance window, the note card, the rating and breaking-change prompts, the error
         report. ButtonPrimaryStyle above labels itself BackgroundTextBrush, which is right on a settings or
         editor page and wrong here — on PRemoteM, SecretKey, Asphalt, Soil, Wine and Forest the panel text
         is white and the content text is black, so those buttons drew black labels and black overlays on a
         dark panel and disappeared. Layer* and PrimaryTextBrush are the same brushes the surrounding text
         on those cards already uses. -->
    <Style x:Key="GlassPanelButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource LayerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource LayerHoverBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="{DynamicResource LayerSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundOnMouseDown" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- The bar-button counterpart of GlassTabButtonStyle, for the small icon buttons that sit on a
         content-tinted card — the share and delete buttons on each runner settings card. Taking
         ButtonBarPrimaryStyle as-is gave them a solid PrimaryMid square and a PrimaryTextBrush glyph, so on
         the light palettes each one was a dark brick with a white glyph punched into the card. BasedOn
         keeps the bar layout and lets the call sites keep their own opacity overrides. -->
    <Style x:Key="GlassContentBarButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBarPrimaryStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource ContentLayerHoverBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundOnMouseDown" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="{DynamicResource ContentLayerSelectedBrush}" />
    </Style>

    <!-- Accent buttons keep the accent — they are the primary action and colour is how that reads — but at
         the alpha AccentGlassBrush carries, so the blue sits in the frost instead of on top of it. -->
    <Style x:Key="GlassButtonAccentStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentGlassBrush}" />
        <Setter Property="attachProperty:VisionElement.BorderBrushOnMouseOver" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BorderBrushOnMouseDown" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource AccentLightBrush}" />
        <Setter Property="attachProperty:VisionElement.ForegroundOnMouseDown" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="{DynamicResource AccentMidBrush}" />
    </Style>

    <Style x:Key="ButtonAccentStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonAccentStyle}" />

    <Style TargetType="Button" BasedOn="{StaticResource GlassButtonAccentStyle}" />
</ResourceDictionary>
